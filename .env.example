# ------------------------------------------------------------------
# SupaSwift environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets.
# ------------------------------------------------------------------

# --- SupaSwift's own backend (Supabase project that powers SupaSwift) ---
# URL + anon key from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-supaswift-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only, never exposed to the browser).
# Used by the scheduler/worker and account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase OAuth app (the "Connect Supabase" integration) ---
# Create an OAuth app in Supabase Dashboard -> Account -> OAuth Apps
# (or Organization settings -> OAuth Apps -> Add application).
#   Redirect URI to add: http://localhost:8080/api/connect/supabase/callback
#   Scopes to request:   projects:read organizations:read (read-only)
SUPABASE_OAUTH_CLIENT_ID=your-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# --- Encryption ---
# Hex-encoded 32-byte key used to encrypt refresh tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- App ---
# Public base URL. Used to build the OAuth redirect URI.
# In production set this to e.g. https://supaswift.app
APP_URL=http://localhost:8080

# Secret that must be sent as the `x-cron-secret` header to /api/cron/checks.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# --- Notifications (optional) ---
# Leave RESEND_API_KEY empty to disable email notifications (checks still run,
# notifications are logged to the server console instead).
RESEND_API_KEY=
# Must be a sender verified in your Resend account.
RESEND_FROM_EMAIL=SupaSwift <onboarding@resend.dev>
